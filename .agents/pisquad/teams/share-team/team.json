{
  "schema_version": 1,
  "team_id": "share-team",
  "config_version": 4,
  "leader": {
    "agent_ref": "share-lead"
  },
  "members": [
    {
      "role_ref": "reviewer",
      "responsibility": "shared review"
    },
    {
      "role_ref": "researcher",
      "responsibility": "count"
    }
  ],
  "instructions_file": "instructions.md",
  "policy": {
    "run_admission": "fifo_single_active",
    "max_parallel_tasks": 2,
    "max_delegate_depth": 1,
    "max_total_tasks": 12,
    "max_attempts_per_task": 3,
    "allowed_tools": [
      "read"
    ],
    "writable_roots": [],
    "acceptance_policy": {
      "mode": "checker",
      "checker_ref": "numbers-count",
      "child_policy": "separate"
    }
  }
}
