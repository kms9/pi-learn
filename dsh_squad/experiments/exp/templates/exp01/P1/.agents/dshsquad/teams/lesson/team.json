{
  "schema_version": 1,
  "team_id": "lesson",
  "config_version": 1,
  "leader": {
    "agent_ref": "chief",
    "mode": "fixed"
  },
  "members": [
    {
      "role_ref": "designer",
      "responsibility": "设计"
    },
    {
      "role_ref": "builder",
      "responsibility": "实现"
    },
    {
      "role_ref": "checker",
      "responsibility": "独立审核"
    }
  ],
  "instructions_file": "instructions.md",
  "default_workflow": "dag",
  "policy": {
    "run_admission": "fifo_single_active",
    "max_parallel_tasks": 2,
    "max_delegate_depth": 2,
    "max_total_tasks": 20,
    "max_attempts_per_task": 3,
    "allowed_tools": [
      "read",
      "grep",
      "find",
      "ls"
    ],
    "writable_roots": [],
    "acceptance_policy": {
      "mode": "review",
      "reviewer_ref": "checker",
      "child_policy": "separate"
    }
  }
}
